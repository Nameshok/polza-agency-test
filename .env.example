# Скопировать в .env ДО `docker compose up`: cp .env.example .env
# .env в git не попадает (см. .gitignore) — в репозитории только этот пример.
# Значения ниже — для локального контейнера, менять их не нужно.

# Из этих трёх docker-compose создаёт базу; в самом compose-файле пароля нет.
POSTGRES_USER=polza
POSTGRES_PASSWORD=polza_local_dev
POSTGRES_DB=polza

# Порт 55432, чтобы не конфликтовать с уже установленным локально Postgres на 5432.
DATABASE_URL=postgresql://polza:polza_local_dev@localhost:55432/polza

# Папка с выгрузкой: page_001.json … page_020.json и review.csv
DATA_DIR=./data
